# Copia este archivo como .env (en esta misma carpeta) y pon tu API key de AI Studio.
GOOGLE_API_KEY=tu_api_key
# Modelo del agente. En free tier, gemini-3.5-flash-lite (~500 peticiones/día) rinde mucho más
# que gemini-3.6-flash (~20/día). Alternativa: gemma-4-31b-it
AGENT_MODEL=gemini-3.5-flash-lite
# Embeddings: "local" (multilingual-e5-small, sin cuota) o "gemini" (gemini-embedding-001, usa cuota)
EMBEDDINGS=local
